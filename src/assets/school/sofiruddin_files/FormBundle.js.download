Length":2000,"width":150,"filteringType":"Editor","filteringParams":{"editorType":"TextArea","useLike":true}},{"name":"StudyElements","title":"Db.PBM.TeacherDiaryKa.StudyElements","editorType":"TextArea","editorParams":{"rows":5,"maxLength":2000},"formCssClass":"col-sm-6","maxLength":2000,"width":150,"filteringType":"Editor","filteringParams":{"editorType":"TextArea","useLike":true}},{"name":"StudentAssessmentTechnique","title":"Db.PBM.TeacherDiaryKa.StudentAssessmentTechnique","editorType":"TextArea","editorParams":{"rows":5,"maxLength":2000},"formCssClass":"col-sm-6","maxLength":2000,"required":true,"width":150,"filteringType":"Editor","filteringParams":{"editorType":"TextArea","useLike":true}},{"name":"InstractionKa","title":"Db.PBM.TeacherDiaryKa.InstractionKa","placeholder":"অধ্যায় ক: পাঠ পরিকল্পনা \r\nপাঠ পরিকল্পনা\r\nশ্রেণিকক্ষে পাঠদান হলো শিক্ষকের জন্য প্রত্যক্ষ শিক্ষণমূলক কাজ। এ কাজ সুষ্ঠুভাবে সম্পাদনের  জন্য পরিকল্পনা প্রয়োজন। দৈনন্দিন শ্রেণি পাঠ যথাযথভাবে পরিচালনার জন্য সুচিন্তিত পদ্ধতিগত ধারাবাহিক প্রক্রিয়াসমূহের সমন্বিত রূপরেখা হলো পাঠ পরিকল্পনা। সামগ্রিকভাবে পাঠ পরিকল্পনা হচ্ছে কোন বিষয়ে ছাত্রছাত্রীদের পাঠদান করার পূর্বেই শিখন - ফল, কর্মপদ্ধতি, উপস্থাপন কৌশল, প্রয়োজনীয় শিক্ষা উপকরণের ব্যবহার ও শিক্ষার্থীদের শিখন - ফল যাচাই ইত্যাদি বিষয়ে পূর্বপ্রস্তুতি গ্রহণ করে শ্রেণিকক্ষে ব্যবহারের জন্য তা ছকে লিপিবদ্ধকরণ। পাঠদানের ক্ষেত্রে এ ধরনের রূপরেখা অত্যন্ত গুরুত্বপূর্ণ এবং এর ব্যবহারে শিক্ষার্থীর শিখন অধিকতর ফলপ্রসূ হয়।\r\nএকটি সুপরিকল্পিত পাঠ পরিকল্পনা শিক্ষককে যেসব বিষয়ে সহায়তা প্রদান করে:\r\n•\tনির্দিষ্ট সময়ে পাঠদান সমাপ্ত করা\r\n•\tপাঠদানের প্রয়োজনীয় প্রস্তুতি গ্রহণ\r\n•\tউপকরণ নির্বাচন, সংগ্রহ ও সঠিক ব্যবহার\r\n•\tপাঠদানকে আনন্দদায়ক ও আকর্ষণীয় করে তোলা\r\n•\tশিক্ষার লক্ষ্য অর্জন\r\n•\tশিক্ষাদানের দক্ষতা বৃদ্ধি করা\r\n•\tসার্বিকভাবে পাঠদানকে ফলপ্রসূ করা\r\nপ্রত্যেক শিক্ষকের পাঠ পরিকল্পনা প্রণয়ন ও তা ব্যবহারের বাধ্যবাধকতা রয়েছে। কিন্তু এ বিষয়ে উদাসীনতা লক্ষ্য করা যায়, যা শিক্ষাদন পদ্ধতির উন্নয়নের প্রধান বাঁধা হিসেবে বিবেচিত হয়। মাধ্যমিক পর্যায়ের প্রত্যেক বিষয় ও শ্রেণিশিক্ষক নিয়মিতভাবে প্রদত্ত নমুনা(টেবিল - ক) অনুযায়ী আলাদা কাগজে পাঠ পরিকল্পনা প্রস্তুত করে ক্লাসে যাবেন এবং তা ফাইল সংরক্ষণ করবেন। বিদ্যালয় পরিদর্শনকালে দায়িত্বপ্রাপ্ত কর্মকর্তাবৃন্দ যে কোন  শিক্ষকের পাঠ পরিকল্পনা নিরীক্ষণ করতে পারবেন।\r\nপ্রত্যেক শিক্ষক শিক্ষকের ডায়েরিতে প্রদত্ত ছক(টেবিল -১) ব্যবহার করে সপ্তাহে প্রতিটি পাঠ্য বিষয়ের অন্তত একটি ক্লাসের পাঠ পরিকল্পনার সংক্ষিপ্ত রেকর্ড লিপিবদ্ধ করবেন, যাতে এ বিষয়ে তাঁদের দক্ষতার ক্রমোন্নতি সম্পর্কে ধারণা পাওয়া যায়। পাঠ পরিকল্পনরা তৈরি শিক্ষকগণের উপর অতিরিক্ত কোন কাজ বা বোঝা নয়, কারণ পাঠ পরিকল্পনা একবার তৈরি করা হলে সেটি বারবার ব্যবহার করা যাবে। পেন্সিলের ব্যবহারে নতুন নতুন আইডিয়াগুলো সংযোজন করা ও প্রয়োজনে মুছে ফেলে নতুন কিছু সংযোজন করা যাবে। প্রত্যেক শিক্ষক পাঠদানের পূর্বে শিক্ষকের ডায়রিতে প্রদত্ত নমুনা টেবিল - ক অনুযায়ী পাঠ পরিকল্পনা প্রস্তুত করবেন। শিক্ষকদের সুবিধার্থে পাঠ পরিকল্পনার দুইটি উদাহরণ এ ডায়েরিতে সংযুক্ত করা হলো।\r\nপ্রতিষ্ঠানের প্রধান প্রতি মাসে শিক্ষকদের পাঠ পরিকল্পনা পরীক্ষা / যাচাই করে স্বাক্ষর করবেন। প্রতি টার্মে একবার শিক্ষকদের সাথে আনুষ্ঠানিক আলোচনার সময় এসব পাঠ পরিকল্পনার বিষয়ে আলোচনা করবেন এবং স্কুল পরিদর্শনের সময় মাউশির দায়িত্বপ্রাপ্ত ক্লাস্টার কর্মকর্তারাও পাঠ পরিকল্পনা ও শিক্ষকের ডায়েরি যাচাই করে এতে স্বাক্ষর করবেন।\r\n","editorType":"TextArea","editorParams":{"rows":10},"readOnly":true,"oneWay":true,"width":250,"sortable":false,"filteringType":"Editor","filteringParams":{"editorType":"TextArea","useLike":true},"notFilterable":true}]);

;


Q.ScriptData.set('Form.PBM.TeacherDiaryKha', [{"name":"Year","title":"Db.PBM.TeacherDiaryKha.Year","editorType":"EMIS.MasterData.DateYearEditorCustom","formCssClass":"col-sm-6","required":true,"width":80,"summaryType":1,"filteringType":"Editor","filteringParams":{"editorType":"EMIS.MasterData.DateYearEditorCustom","useLike":false}},{"name":"TermId","title":"Db.PBM.TeacherDiaryKha.TermId","editorType":"Lookup","editorParams":{"lookupKey":"PBM.Term"},"formCssClass":"col-sm-6","required":true,"width":80,"filteringType":"Lookup","filteringParams":{"lookupKey":"PBM.Term"}},{"name":"ClassId","title":"Db.PBM.TeacherDiaryKha.ClassId","editorType":"Lookup","editorParams":{"lookupKey":"Common.Class_OrderByAsc_Lookup"},"formCssClass":"col-sm-6","required":true,"width":80,"filteringType":"Lookup","filteringParams":{"lookupKey":"Common.Class_OrderByAsc_Lookup"}},{"name":"SubjectId","title":"Db.PBM.TeacherDiaryKha.SubjectId","editorType":"Lookup","editorParams":{"lookupKey":"IMS.IMS_Subject"},"formCssClass":"col-sm-6","required":true,"width":80,"filteringType":"Lookup","filteringParams":{"lookupKey":"IMS.IMS_Subject"}},{"name":"StudentList","title":"Db.PBM.TeacherDiaryKha.StudentList","editorType":"EMIS.PBM.LessSuccessfulStudentsEditor","category":"Special guidence for less successful students","width":80,"sortable":false,"summaryType":0,"filteringType":"Editor","filteringParams":{"editorType":"EMIS.PBM.LessSuccessfulStudentsEditor","useLike":false},"notFilterable":true},{"name":"InstractionKha","title":"Db.PBM.TeacherDiaryKha.InstractionKha","placeholder":"অধ্যায় খ\r\n\r\n•\tস্বল্প কৃতিত্বধারী শিক্ষার্থীদের  জন্য বিশেষ সহায়তা কার্যক্রম এবং পরিবীক্ষণ   \r\n•\tবিষয়ভিত্তিক শিক্ষকসভা\r\nবিষয় শিক্ষক এবং শ্রেণি শিক্ষকগণ প্রতি টার্মে বিষয়ভিত্তিক শতকরা ৩০ ভাগের কম নম্বর পাওয়া স্বল্প কৃতিত্বধারী শিক্ষার্থীর তালিকা প্রস্তুত করবেন এবং তা প্রধান শিক্ষকের কাছে জমা দিবেন\r\nপ্রত্যেক বিষয় শিক্ষক ডায়েরিতে তার বিষয়ের স্বল্প কৃতিত্বধারী শিক্ষার্থীর তালিকা প্রস্তুত করবেন (টেবিল-খ ১)।\r\nপ্রত্যেক বিষয় শিক্ষক তালিকাভুক্ত স্বল্প কৃতিত্বধারী শিক্ষার্থীদের বিশেষ সহায়তা প্রদান কার্যক্রমের রেকর্ড ডায়েরিতে লিপিবদ্ধ করবেন। যেমন-\r\n•\tনিয়মিত শ্রেণি পাঠদানকালে স্বল্প কৃতিত্বধারী শিক্ষার্থীর সাথে উঁচু কৃতিত্বধারী শিক্ষার্থীর জোড়বদ্ধকরণ\r\n•\tবিশেষভাবে প্রদত্ত বাড়ির কাজ (Home task) এবং\r\n•\tবৃহস্পতিবার অপরাহ্নে বিশেষ টিউটোরিয়াল ক্লাশ\r\n•\tপ্রত্যেক শিক্ষক প্রতি টার্মে অন্তত একবার প্রতি বিষয়ে বিষয়ভিত্তিক শিক্ষকসভায় অংশগ্রহণ করবেন এবং ডায়েরিতে সভা আয়োজনের তারিখ ও আলোচনার বিষয় লিপিবদ্ধ করবেন (টেবিল-খ ২)\r\n\r\n•\tসহায়তার ধরন: বিশেষ টিউটোরিয়াল, জোড়বদ্ধকরণ, অতিরিক্ত বাড়ির কাজ, সহ-শিক্ষাক্রমিক কার্যক্রম ও অন্যান্য। প্রত্যেক শিক্ষক প্রতি সপ্তাহে প্রতি বিষয়ে কমপক্ষে ১টি সহায়তা পরিচালনা করবেন।\r\n","editorType":"TextArea","editorParams":{"rows":10},"category":"Special guidence for less successful students","readOnly":true,"oneWay":true,"width":250,"sortable":false,"filteringType":"Editor","filteringParams":{"editorType":"TextArea","useLike":true},"notFilterable":true}]);

;

